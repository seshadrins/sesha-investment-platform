POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql+psycopg://portfolio_user:change_this_local_password@db:5432/portfolio
API_BASE_URL=http://api:8000
APP_TITLE=Personal AI Portfolio Manager
DEFAULT_CURRENCY=INR
MAX_POSITION_WEIGHT=0.15
TRIM_POSITION_WEIGHT=0.20
PREFERRED_HOLD_DAYS=365
LOSS_REVIEW_THRESHOLD=-0.15
PROFIT_REVIEW_THRESHOLD=0.30
UPSTOX_ANALYTICS_TOKEN=
ANALYSIS_SCHEDULE_HOUR=6
ANALYSIS_SCHEDULE_MINUTE=0
ANALYSIS_SCHEDULE_DAYS=tue-sat
ANALYSIS_SCHEDULE_TIMEZONE=Asia/Kolkata
ANALYSIS_RUN_ON_STARTUP=true
FUNDAMENTALS_BATCH_SIZE=10
SCREENING_BATCH_SIZE=10
UNIVERSE_SCHEDULE_MONTHS=4,10
INVESTOR_DISCLOSURE_LAG_DAYS=21
DISCLOSURE_AUTO_INGEST_ENABLED=true
DISCLOSURE_BATCH_SIZE=10
DISCLOSURE_REQUEST_INTERVAL_SECONDS=1.0
DISCLOSURE_CACHE_HOURS=24
DISCLOSURE_FUZZY_MATCH_THRESHOLD=0.84
DISCLOSURE_LLM_PROVIDER=auto
DISCLOSURE_LLM_MAX_CHARS=120000
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
NOTIFICATION_WEBHOOK_URL=
ANALYSIS_START_GRACE_MINUTES=15
ANALYSIS_STALL_MINUTES=90
ANALYSIS_CATCHUP_MAX_HOURS=48
ANALYSIS_RETRY_DELAYS_MINUTES=30,60
SCHEDULER_HEARTBEAT_SECONDS=60
